# ==============================================================================
# CSI Club Operations Platform - Notion & Supabase Integration Environment
# ==============================================================================

# Notion Server-Side Integration Credentials (NEVER expose to frontend)
# Obtain an internal integration token from: https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_your_secret_notion_api_key_here

# Notion Database IDs (Extracted from Notion URL: https://notion.so/<workspace>/<database_id>?v=...)
NOTION_DATABASE_ID_MEMBERS=your_members_database_id_here
NOTION_DATABASE_ID_EVENTS=your_events_database_id_here
NOTION_DATABASE_ID_ASSIGNMENTS=your_assignments_database_id_here

# Supabase Configuration
# Obtain from Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional Anon key (if accessed in client or restricted contexts)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Synchronization Behavior & Conflict Policy
# Options:
#   - "notion_wins": Overwrite local Supabase records with incoming Notion data
#   - "app_wins": Overwrite Notion pages with local Supabase data
#   - "latest_wins": Compare updated_at timestamps (Notion last_edited_time vs Supabase updated_at)
#   - "manual": Flag conflict in sync job without mutating either side
NOTION_SYNC_CONFLICT_STRATEGY=latest_wins

# Reliability & Rate Limiting Configuration
# Notion rate limit is ~3 requests/second
NOTION_MAX_RETRIES=4
NOTION_INITIAL_RETRY_DELAY_MS=1000
NOTION_REQUESTS_PER_SECOND=2.5

# Batch Processing
NOTION_SYNC_BATCH_SIZE=50
